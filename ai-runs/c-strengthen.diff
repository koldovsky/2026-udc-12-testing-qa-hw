diff --git a/app/test/unit/day-cap.test.js b/app/test/unit/day-cap.test.js
index 817aaf4..e19db70 100644
--- a/app/test/unit/day-cap.test.js
+++ b/app/test/unit/day-cap.test.js
@@ -2,12 +2,52 @@ import test from "node:test";
 import assert from "node:assert/strict";
 import { createDayCap, DAY_CAP, dayKey } from "../../src/day-cap.js";
 
+// T6 (docs/spec/tariffs.md:93-95): 300 UAH per rider per day.
+test("the daily cap is 300 UAH", () => {
+  assert.equal(DAY_CAP, 30000);
+  assert.equal(createDayCap().limit, 30000);
+});
+
 test("charges recorded for a day reduce what is left of the cap", () => {
   const ledger = createDayCap();
   ledger.record("rider-1", "2026-09-16T08:00:00Z", 12000);
-  assert.ok(ledger.remaining("rider-1", "2026-09-16T12:00:00Z") < DAY_CAP);
+  assert.equal(ledger.remaining("rider-1", "2026-09-16T12:00:00Z"), 18000);
+});
+
+test("what is left of the cap never goes below zero", () => {
+  const ledger = createDayCap();
+  ledger.record("rider-1", "2026-09-16T08:00:00Z", 35000);
+  assert.equal(ledger.remaining("rider-1", "2026-09-16T12:00:00Z"), 0);
+});
+
+test("charges are kept per rider and per day", () => {
+  const ledger = createDayCap();
+  ledger.record("rider-1", "2026-09-16T08:00:00Z", 12000);
+  ledger.record("rider-1", "2026-09-16T10:00:00Z", 5000);
+  assert.equal(ledger.chargedOn("rider-1", "2026-09-16"), 17000);
+  assert.equal(ledger.remaining("rider-2", "2026-09-16T12:00:00Z"), DAY_CAP);
+  assert.equal(ledger.remaining("rider-1", "2026-09-17T12:00:00Z"), DAY_CAP);
+});
+
+test("nothing is charged for a rider or day with no rides", () => {
+  const ledger = createDayCap();
+  ledger.record("rider-1", "2026-09-16T08:00:00Z", 12000);
+  assert.equal(ledger.chargedOn("rider-2", "2026-09-16"), 0);
+  assert.equal(ledger.chargedOn("rider-1", "2026-09-17"), 0);
+});
+
+test("a custom limit replaces the default cap", () => {
+  const ledger = createDayCap({ limit: 1000 });
+  ledger.record("rider-1", "2026-09-16T08:00:00Z", 400);
+  assert.equal(ledger.remaining("rider-1", "2026-09-16T12:00:00Z"), 600);
 });
 
 test("the day of a ride is the date of its pickup", () => {
   assert.equal(dayKey("2026-09-16T08:00:00Z"), "2026-09-16");
 });
+
+// T6 «Доба»: the Kyiv calendar date — 23:40 UTC on 16.09 is already 17.09 in Kyiv (UTC+3).
+test("the day of a ride is the Kyiv calendar date, not the UTC one", () => {
+  assert.equal(dayKey("2026-09-16T23:40:00Z"), "2026-09-17");
+  assert.equal(dayKey("2026-09-16T23:40:00+03:00"), "2026-09-16");
+});
diff --git a/app/test/unit/tariff.test.js b/app/test/unit/tariff.test.js
index bb73c2b..c44d71d 100644
--- a/app/test/unit/tariff.test.js
+++ b/app/test/unit/tariff.test.js
@@ -91,3 +91,51 @@ test("a 45-minute classic ride costs 50 UAH", () => {
 test("a return before the pickup is rejected", () => {
   assert.throws(() => quote(ride("2026-09-16T08:00:00Z", "2026-09-16T07:00:00Z"), standard), QuoteError);
 });
+
+// T10 + T4 (docs/spec/tariffs.md:76, :140): a subscriber's 30-min classic night ride costs 0;
+// there is nothing to discount, so the quote has no discount lines at all — no zero "night" line.
+test("a night ride with nothing to pay has no night discount line", () => {
+  // 01:00–01:30 in Kyiv
+  const result = quote(ride("2026-09-16T01:00:00+03:00", "2026-09-16T01:30:00+03:00"), { type: "subscriber" });
+  assert.equal(result.timeCharge, 2500);
+  assert.deepEqual(result.discounts, [{ code: "subscription", amount: 2500 }]);
+  assert.equal(result.total, 0);
+});
+
+// T2 + T10: a false start at night — no time charge, so no discount lines either.
+test("a night false start has no discount lines", () => {
+  const result = quote(ride("2026-09-16T03:00:00+03:00", "2026-09-16T03:01:00+03:00"), standard);
+  assert.equal(result.timeCharge, 0);
+  assert.deepEqual(result.discounts, []);
+  assert.equal(result.total, 0);
+});
+
+// Section 4: a missing ride is refused with a QuoteError, not a TypeError from inside quote().
+test("a missing ride is refused with a QuoteError", () => {
+  for (const missing of [null, undefined]) {
+    assert.throws(() => quote(missing, standard), { name: "QuoteError", message: "ride is required" });
+  }
+});
+
+// Instants must carry Z or an offset (src/tariff.js header, AGENTS.md conventions):
+// without one Date.parse() would silently read the server's local time.
+test("a date-time without an offset is refused", () => {
+  const cases = [
+    ride("2026-09-16T10:00:00", "2026-09-16T10:30:00Z"),
+    ride("2026-09-16T10:00:00Z", "2026-09-16T10:30:00"),
+  ];
+  for (const r of cases) {
+    assert.throws(() => quote(r, standard), { name: "QuoteError", message: /must be an ISO 8601 date-time with an offset/ });
+  }
+});
+
+// A non-string instant is refused even when its string form looks like a valid date-time.
+test("a non-string date-time is refused", () => {
+  const cases = [
+    ride(["2026-09-16T10:00:00Z"], "2026-09-16T10:30:00Z"),
+    ride("2026-09-16T10:00:00Z", Date.parse("2026-09-16T10:30:00Z")),
+  ];
+  for (const r of cases) {
+    assert.throws(() => quote(r, standard), { name: "QuoteError", message: /must be an ISO 8601 date-time with an offset/ });
+  }
+});
