diff --git a/app/test/unit/day-cap.test.js b/app/test/unit/day-cap.test.js
index 817aaf4..778a16c 100644
--- a/app/test/unit/day-cap.test.js
+++ b/app/test/unit/day-cap.test.js
@@ -11,3 +11,34 @@ test("charges recorded for a day reduce what is left of the cap", () => {
 test("the day of a ride is the date of its pickup", () => {
   assert.equal(dayKey("2026-09-16T08:00:00Z"), "2026-09-16");
 });
+
+test("a rider with no charges has the whole cap left", () => {
+  const ledger = createDayCap();
+  assert.equal(ledger.remaining("nobody", "2026-09-16T08:00:00Z"), DAY_CAP);
+});
+
+test("remaining is reduced by exactly what was recorded and never below zero", () => {
+  const ledger = createDayCap({ limit: 1000 });
+  ledger.record("r", "2026-09-16T08:00:00Z", 300);
+  ledger.record("r", "2026-09-16T09:00:00Z", 200);
+  assert.equal(ledger.remaining("r", "2026-09-16T10:00:00Z"), 500);
+  ledger.record("r", "2026-09-16T11:00:00Z", 900);
+  assert.equal(ledger.remaining("r", "2026-09-16T12:00:00Z"), 0);
+});
+
+test("chargedOn is zero for an unknown day or rider and sums a day's charges", () => {
+  const ledger = createDayCap();
+  assert.equal(ledger.chargedOn("r", "2026-09-16"), 0);
+  ledger.record("r", "2026-09-16T08:00:00Z", 300);
+  ledger.record("r", "2026-09-16T09:00:00Z", 200);
+  assert.equal(ledger.chargedOn("r", "2026-09-16"), 500);
+  assert.equal(ledger.chargedOn("r", "2026-09-17"), 0);
+  assert.equal(ledger.chargedOn("other", "2026-09-16"), 0);
+});
+
+test("charges are kept per rider and per Kyiv day", () => {
+  const ledger = createDayCap();
+  ledger.record("r", "2026-09-16T20:59:00Z", 1000); // 23:59 Kyiv, 16.09
+  assert.equal(ledger.remaining("r", "2026-09-16T21:00:00Z"), DAY_CAP); // 00:00 Kyiv, 17.09
+  assert.equal(ledger.remaining("other", "2026-09-16T20:59:00Z"), DAY_CAP);
+});
diff --git a/app/test/unit/tariff-boundaries.test.js b/app/test/unit/tariff-boundaries.test.js
new file mode 100644
index 0000000..5bf524f
--- /dev/null
+++ b/app/test/unit/tariff-boundaries.test.js
@@ -0,0 +1,84 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createDayCap, DAY_CAP } from "../../src/day-cap.js";
+import { QuoteError, quote } from "../../src/tariff.js";
+
+const ride = (pickupAt, returnAt, extra = {}) => ({ pickupAt, returnAt, bike: "classic", returnStation: "S01", ...extra });
+const standard = { type: "standard" };
+// Kyiv summer time is UTC+3, so these are explicit Kyiv wall-clock instants.
+const kyiv = (time, day = 16) => `2026-09-${day}T${time}+03:00`;
+
+// T10: the night discount applies to pickups before 06:00 Kyiv, not at or after it.
+test("a pickup at 05:59 gets the night discount", () => {
+  const result = quote(ride(kyiv("05:59:00"), kyiv("06:29:00")), standard);
+  assert.deepEqual(result.discounts, [{ code: "night", amount: 750 }]);
+  assert.equal(result.total, 1750);
+});
+
+test("a pickup at 06:00 does not get the night discount", () => {
+  const result = quote(ride(kyiv("06:00:00"), kyiv("06:30:00")), standard);
+  assert.deepEqual(result.discounts, []);
+  assert.equal(result.total, 2500);
+});
+
+test("a pickup at 06:30 does not get the night discount", () => {
+  const result = quote(ride(kyiv("06:30:00"), kyiv("07:00:00")), standard);
+  assert.deepEqual(result.discounts, []);
+});
+
+test("a free night ride lists no discounts", () => {
+  const result = quote(ride(kyiv("01:00:00"), kyiv("01:02:00")), standard);
+  assert.deepEqual(result.discounts, []);
+  assert.equal(result.total, 0);
+});
+
+test("a free subscriber ride lists only the subscription discount", () => {
+  const result = quote(ride(kyiv("12:00:00"), kyiv("12:30:00")), { type: "subscriber" });
+  assert.deepEqual(result.discounts, [{ code: "subscription", amount: 2500 }]);
+});
+
+test("a standard rider has no fare discount entry", () => {
+  const result = quote(ride(kyiv("12:00:00"), kyiv("12:30:00")), standard);
+  assert.deepEqual(result.discounts, []);
+});
+
+// T5: equal sums -> the subscription applies.
+test("on equal sums the subscription wins over the reduced fare", () => {
+  const result = quote(ride(kyiv("12:00:00"), kyiv("13:00:00")), { type: "subscriber", concession: true });
+  assert.deepEqual(result.discounts, [{ code: "subscription", amount: 2500 }]);
+  assert.equal(result.total, 2500);
+});
+
+// T6: a charge exactly equal to what is left of the cap is not capped.
+test("a charge equal to the remaining cap adds no day-cap discount", () => {
+  const dayCap = createDayCap();
+  dayCap.record("u1", kyiv("08:00:00"), DAY_CAP - 2500);
+  const result = quote(ride(kyiv("12:00:00"), kyiv("12:30:00")), { ...standard, id: "u1" }, { dayCap });
+  assert.deepEqual(result.discounts, []);
+  assert.equal(result.total, 2500);
+  assert.equal(dayCap.remaining("u1", kyiv("12:00:00")), 0);
+});
+
+test("a charge above the remaining cap is cut to it", () => {
+  const dayCap = createDayCap();
+  dayCap.record("u1", kyiv("08:00:00"), DAY_CAP - 2500);
+  const result = quote(ride(kyiv("12:00:00"), kyiv("13:00:00")), { ...standard, id: "u1" }, { dayCap });
+  assert.deepEqual(result.discounts, [{ code: "day-cap", amount: 2500 }]);
+  assert.equal(result.total, 2500);
+});
+
+// Input validation.
+test("a missing ride is a QuoteError", () => {
+  assert.throws(() => quote(null, standard), QuoteError);
+  assert.throws(() => quote(undefined, standard), QuoteError);
+});
+
+test("a date without time or offset is a QuoteError", () => {
+  assert.throws(() => quote(ride("2026-09-16", "2026-09-16T08:00:00Z"), standard), QuoteError);
+  assert.throws(() => quote(ride("2026-09-16T07:00:00Z", "2026-09-16T08:00:00"), standard), QuoteError);
+});
+
+test("a non-string instant is a QuoteError even if it prints as a date-time", () => {
+  const lookalike = { toString: () => "2026-09-16T07:00:00Z" };
+  assert.throws(() => quote(ride(lookalike, "2026-09-16T08:00:00Z"), standard), QuoteError);
+});
