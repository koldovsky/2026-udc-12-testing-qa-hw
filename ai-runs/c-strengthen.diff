diff --git a/app/test/unit/mutation-boundaries.test.js b/app/test/unit/mutation-boundaries.test.js
new file mode 100644
index 0000000..2dc8272
--- /dev/null
+++ b/app/test/unit/mutation-boundaries.test.js
@@ -0,0 +1,76 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { quote, discount, QuoteError } from '../../src/tariff.js';
+import { createDayCap } from '../../src/day-cap.js';
+
+const ride = {
+  pickupAt: '2026-09-16T10:00:00+03:00',
+  returnAt: '2026-09-16T10:30:00+03:00',
+  bike: 'classic',
+  returnStation: 'S01',
+};
+const rider = { type: 'standard', id: 'boundary-rider' };
+
+test('T10: 06:00 Kyiv is outside the night discount', () => {
+  const result = quote({ ...ride, pickupAt: '2026-09-16T06:00:00+03:00',
+    returnAt: '2026-09-16T06:30:00+03:00' }, rider);
+  assert.deepEqual(result, { minutes: 30, timeCharge: 2500, discounts: [], fees: [], total: 2500 });
+});
+
+test('T2, T9, T10: a free night ride has no zero-valued discount line', () => {
+  const result = quote({ ...ride, pickupAt: '2026-09-16T01:00:00+03:00',
+    returnAt: '2026-09-16T01:01:00+03:00' }, rider);
+  assert.deepEqual(result, { minutes: 1, timeCharge: 0, discounts: [], fees: [], total: 0 });
+});
+
+test('T6, T9: exactly reaching the cap needs no cap deduction line', () => {
+  const dayCap = createDayCap();
+  dayCap.record(rider.id, ride.pickupAt, 27500);
+  const result = quote(ride, rider, { dayCap });
+  assert.deepEqual(result, { minutes: 30, timeCharge: 2500, discounts: [], fees: [], total: 2500 });
+  assert.equal(dayCap.chargedOn(rider.id, '2026-09-16'), 30000);
+  assert.equal(dayCap.remaining(rider.id, ride.pickupAt), 0);
+});
+
+test('T1, T3: even one millisecond starts the next minute and block', () => {
+  const result = quote({ ...ride, returnAt: '2026-09-16T10:30:00.001+03:00' }, rider);
+  assert.deepEqual(result, { minutes: 31, timeCharge: 5000, discounts: [], fees: [], total: 5000 });
+});
+
+test('T9: fractional kopecks are rounded in the rider’s favour', () => {
+  // Specification example: 1235 * 0.7 = 864.5; payable 864, discount 371.
+  assert.equal(discount(1235, 30), 371);
+  assert.equal(discount(1, 30), 1);
+});
+
+test('T1, T2: simultaneous pickup and return is a valid zero-minute ride', () => {
+  assert.deepEqual(quote({ ...ride, returnAt: ride.pickupAt }, rider),
+    { minutes: 0, timeCharge: 0, discounts: [], fees: [], total: 0 });
+});
+
+test('invalid ride containers are rejected with an explanation of the missing ride', () => {
+  for (const value of [null, undefined, 'ride', 42]) {
+    assert.throws(() => quote(value, rider), { name: 'QuoteError', message: 'ride is required' });
+  }
+});
+
+test('timestamps require ISO strings with an offset, for both fields', () => {
+  for (const field of ['pickupAt', 'returnAt']) {
+    for (const value of [new String(ride[field]), '2026-09-16T10:00:00', '2026-99-16T10:00:00Z']) {
+      assert.throws(() => quote({ ...ride, [field]: value }, rider), error => {
+        assert.ok(error instanceof QuoteError);
+        assert.match(error.message, new RegExp(field));
+        return true;
+      });
+    }
+  }
+});
+
+test('T6: an uncharged rider or day has zero charges without creating an entry', () => {
+  const dayCap = createDayCap();
+  assert.equal(dayCap.chargedOn(rider.id, '2026-09-16'), 0);
+  assert.equal(dayCap.remaining(rider.id, ride.pickupAt), 30000);
+  dayCap.record(rider.id, ride.pickupAt, 2500);
+  assert.equal(dayCap.chargedOn('other-rider', '2026-09-16'), 0);
+  assert.equal(dayCap.chargedOn(rider.id, '2026-09-17'), 0);
+});
