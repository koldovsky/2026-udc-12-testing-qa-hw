diff --git a/app/test/unit/day-cap.test.js b/app/test/unit/day-cap.test.js
index 817aaf4..a1f5137 100644
--- a/app/test/unit/day-cap.test.js
+++ b/app/test/unit/day-cap.test.js
@@ -11,3 +11,31 @@ test("charges recorded for a day reduce what is left of the cap", () => {
 test("the day of a ride is the date of its pickup", () => {
   assert.equal(dayKey("2026-09-16T08:00:00Z"), "2026-09-16");
 });
+
+// T6 (docs/spec/tariffs.md:100-103): the cap is 30000 per rider per Kyiv calendar day.
+test("a day with no charges has 0 charged and the whole cap left", () => {
+  const ledger = createDayCap();
+  assert.deepEqual(
+    { charged: ledger.chargedOn("rider-1", "2026-09-16"), left: ledger.remaining("rider-1", "2026-09-16T12:00:00+03:00") },
+    { charged: 0, left: 30000 },
+  );
+});
+
+// T6: the charges of one rider on one Kyiv day add up; a ride belongs to the day of its pickup
+// in Kyiv time (:101-102); another day and another rider have their own sums.
+test("chargedOn sums one rider's charges of one Kyiv day, apart from other days and riders", () => {
+  const ledger = createDayCap();
+  ledger.record("rider-1", "2026-09-16T08:00:00+03:00", 12000);
+  ledger.record("rider-1", "2026-09-16T23:40:00+03:00", 5000); // 20:40Z — still 16.09 in Kyiv
+  ledger.record("rider-1", "2026-09-17T00:30:00+03:00", 2500); // 16.09 21:30Z — already 17.09 in Kyiv
+  ledger.record("rider-2", "2026-09-16T09:00:00+03:00", 4000);
+  assert.deepEqual(
+    {
+      rider1on16: ledger.chargedOn("rider-1", "2026-09-16"),
+      rider1on17: ledger.chargedOn("rider-1", "2026-09-17"),
+      rider2on16: ledger.chargedOn("rider-2", "2026-09-16"),
+      rider1leftOn16: ledger.remaining("rider-1", "2026-09-16T18:00:00+03:00"),
+    },
+    { rider1on16: 17000, rider1on17: 2500, rider2on16: 4000, rider1leftOn16: 13000 },
+  );
+});
diff --git a/app/test/unit/tariff.test.js b/app/test/unit/tariff.test.js
index e891769..ca7e30b 100644
--- a/app/test/unit/tariff.test.js
+++ b/app/test/unit/tariff.test.js
@@ -92,3 +92,28 @@ test("a 45-minute classic ride costs 50 UAH", () => {
 test("a return before the pickup is rejected", () => {
   assert.throws(() => quote(ride("2026-09-16T08:00:00Z", "2026-09-16T07:00:00Z"), standard), QuoteError);
 });
+
+// Section 4 (docs/spec/tariffs.md:147-149): invalid data — no price, the request is rejected with an
+// explanation. The explanation text is not specified, so only its presence is checked (as in
+// test/spec/invalid-input.test.js). A QuoteError is what POST /api/quote turns into 400
+// (src/server.js:38); any other error becomes 500 "internal error" with no explanation.
+const rejectedWithExplanation = (err) => err instanceof QuoteError && err.message.trim() !== "";
+
+test("a missing ride is rejected with an explanation, not a crash", () => {
+  // `{ "ride": null }` in the request body reaches quote() as is (src/server.js:33).
+  for (const missing of [null, undefined]) {
+    assert.throws(() => quote(missing, standard), rejectedWithExplanation, String(missing));
+  }
+});
+
+// A moment is an ISO 8601 string with an offset (src/tariff.js:5); a JSON array holding such a
+// string is not one, even though it reads as the string when converted.
+test("a pickup or return moment that is not a string is rejected", () => {
+  const rides = {
+    pickupAt: ride(["2026-09-16T07:00:00Z"], "2026-09-16T07:50:00Z"),
+    returnAt: ride("2026-09-16T07:00:00Z", ["2026-09-16T07:50:00Z"]),
+  };
+  for (const [field, r] of Object.entries(rides)) {
+    assert.throws(() => quote(r, standard), rejectedWithExplanation, field);
+  }
+});
